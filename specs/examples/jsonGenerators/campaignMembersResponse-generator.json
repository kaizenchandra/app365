{
  "data": [
    '{{repeat(10, 10)}}',
    {
      "id": '{{guid()}}',
      "idCard": '{{integer(120, 123)}}-{{integer(1000000, 9999999)}}-{{integer(1, 9)}}',
      "firstName": '{{firstName()}}',
      "lastName": '{{surname()}}',
      "fullName": function(tags){
        return this.firstName + ' ' + this.lastName;
      },
      "profilePicture": 'http://placehold.it/400x300',
      "birthDate": '{{date(new Date(1970, 0, 1), new Date(2000, 0, 1), "YYYY-MM-dd")}}',
      "age": function(tags){
        return parseInt(((new Date().getTime() / 1000) - (Date.parse(this.birthDate) / 1000)) / (60 * 60 * 24 * 365), 10);
      },
      "memberSince": '{{date(new Date(2018, 0, 1), new Date(2020, 0, 1), "YYYY-MM-ddTHH:mm:ssZ")}}',
      "address": {
        "country": '{{country()}}',
        "state": '{{state()}}',
        "municipality": '{{state()}}',
        "city": '{{city()}}',
        "sector": '{{city()}}',
        "line1": '{{city()}}',
        "line2": '{{street()}}',
        "zipCode": '{{integer(100, 999)}}',
        "reference": '{{street()}}',
        "fullAddress": '{{integer(100, 999)}} {{street()}}, {{city()}}, {{state()}}, {{integer(100, 10000)}}'
      },
      "team": {
        "levelCount": '{{integer(1, 10)}}',
        "memberCount": '{{integer(15, 100)}}'
      }
    }
  ],
  "pagination": {
    "totalPages": 1,
    "totalElements": 10,
    "page": 0,
    "size": 10,
    "numberOfElements": 10
  }
}
