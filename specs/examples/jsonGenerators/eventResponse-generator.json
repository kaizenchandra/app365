{
  "id": '{{guid()}}',
  "title": '{{lorem(5, "words")}}',
  "content": '{{lorem(2, "paragraphs")}}',
  "startDate": '{{date(new Date(2018, 0, 1), new Date(2020, 0, 1), "YYYY-MM-ddTHH:mm:ssZ")}}',
  "createdAt": '{{date(new Date(2018, 0, 1), new Date(2020, 0, 1), "YYYY-MM-ddTHH:mm:ssZ")}}',
  "coverPicture": 'http://placehold.it/400x300',
  "isFlagged": '{{bool()}}',
  "location": {
    "address": '{{integer(100, 999)}} {{street()}}, {{city()}}, {{state()}}, {{integer(100, 10000)}}',
    "geo": {
      "lat": '{{floating(-90.000001, 90)}}',
      "lon": '{{floating(-180.000001, 180)}}'
    }
  },
  "summary": {
    "joinCount": '{{integer(1, 100)}}',
    "shareCount": '{{integer(1, 100)}}',
    "commentCount": '{{integer(1, 100)}}',
    "likeCount": '{{integer(1, 100)}}'
  },
  "meta": {
    "lastComment": {
      "content": '{{lorem(3, "sentences")}}',
      "createdAt": '{{date(new Date(2018, 0, 1), new Date(2020, 0, 1), "YYYY-MM-ddTHH:mm:ssZ")}}',
      "owner": {
        "id": '{{guid()}}',
        "fullName": '{{firstName()}} {{surname()}}',
        "profilePicture": 'http://placehold.it/400x300'
      }
    },
    "user": {
      "liked": '{{bool()}}',
      "commented": '{{bool()}}',
      "shared": '{{bool()}}',
      "joined": '{{bool()}}',
      "calendars": [
        '{{repeat(1, 3)}}',
        {
          "platform": '{{random("ios", "android")}}',
          "calendarId": '{{guid()}}'
        }
      ]
    }
  },
  "cursor": {
    "next": '{{guid()}}'
  }
}
