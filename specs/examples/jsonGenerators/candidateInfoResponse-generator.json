{
  "id": '{{guid()}}',
  "firstName": '{{firstName()}}',
  "lastName": '{{surname()}}',
  "fullName": function(tags){
    return this.firstName + ' ' + this.lastName;
  },
  "profilePicture": 'http://placehold.it/400x300',
  "party": {
    "name": '{{lorem(3, "words")}}',
    "nameAbbr": function(tags){
      var parts = this.name.split(' ');
      return parts[0].charAt(0).toUpperCase() + parts[1].charAt(0).toUpperCase()+parts[2].charAt(0).toUpperCase();
    },
    "bannerPicture": 'http://placehold.it/400x300',
      "slogan": '{{lorem(4, "words")}}'
  },
  "summary": {
    "donationCount": '{{integer(1, 100)}}',
    "offerCount": '{{integer(1, 100)}}',
    "shareCount": '{{integer(1, 100)}}',
    "commentCount": '{{integer(1, 100)}}',
    "likeCount": '{{integer(1, 100)}}',
    "postCount": '{{integer(1, 100)}}',
    "postCommentCount": '{{integer(1, 100)}}'
  },
  "bio": {
    "description": '{{lorem(3, "paragraphs")}}'
  },
  "meta": {
    "lastComment": {
      "id": '{{guid()}}',
      "content": '{{lorem(3, "sentences")}}',
      "createdAt": '{{date(new Date(2018, 0, 1), new Date(2020, 0, 1), "YYYY-MM-ddTHH:mm:ssZ")}}',
      "owner": {
        "id": '{{guid()}}',
        "firstName": '{{firstName()}}',
        "lastName": '{{surname()}}',
        "fullName": function (tags) {
          return this.firstName + ' ' + this.lastName;
        },
        "nickname": function (tags) {
          return this.firstName;
        },
        "profilePicture": 'http://placehold.it/400x300'
      }
    },
    "user": {
      "liked": '{{bool()}}',
      "commented": '{{bool()}}',
      "shared": '{{bool()}}'
    }
  }
}
