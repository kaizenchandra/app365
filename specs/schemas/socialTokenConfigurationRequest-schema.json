{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "appId",
    "provider",
    "appSecret"
  ],
  "properties": {
    "appId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": ["facebook", "twitter"]
    },
    "appSecret": {
      "type": "string"
    },
    "accessToken": {
      "type": "string"
    },
    "accessTokenSecret": {
      "type": "string"
    }
  }
}
