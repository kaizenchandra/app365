{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "token",
      "channel"
    ],
    "properties": {
      "token": {
        "type": "string"
      },
      "channel": {
        "type": "string",
        "enum": ["facebook", "twitter", "google_plus"]
      }
    }
  }
}
