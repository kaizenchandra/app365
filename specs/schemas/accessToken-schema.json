{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "access_token": {
      "type": "string",
      "description": "The access token."
    },
    "expires_in": {
      "type": "integer",
      "description": "Validity time for the access token in seconds."
    },
    "token_type": {
      "type": "string",
      "description": "Token type, by example 'Bearer'."
    },
    "scope": {
      "type": "string",
      "description": "List of permissions assigned to the access token."
    },
    "refresh_token": {
      "type": "string",
      "description": "Token to renew the access token when expired."
    }
  },
  "required": [
    "access_token",
    "expires_in",
    "token_type",
    "scope",
    "refresh_token"
  ]
}
