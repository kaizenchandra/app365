{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "thumbnail": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "properties": {
        "shareCount": {
          "type": "integer"
        },
        "commentCount": {
          "type": "integer"
        },
        "likeCount": {
          "type": "integer"
        }
      },
      "required": [
        "shareCount",
        "commentCount",
        "likeCount"
      ]
    },
    "owner": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "fullName": {
          "type": "string"
        },
        "nickname": {
          "type": "string"
        },
        "profilePicture": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "fullName",
        "profilePicture"
      ]
    }
  },
  "required": [
    "id",
    "title",
    "content",
    "createdAt",
    "thumbnail",
    "summary",
    "owner"
  ]
}
