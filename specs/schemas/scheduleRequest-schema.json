{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "taskId": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "day": {
            "type": "integer"
          },
          "startTime": {
            "type": "string",
            "format": "time"
          },
          "endTime": {
            "type": "string",
            "format": "time"
          }
        },
        "required": [
          "day",
          "startTime",
          "endTime"
        ]
      }
    }
  },
  "required": [
    "taskId",
    "note",
    "entries"
  ]
}
