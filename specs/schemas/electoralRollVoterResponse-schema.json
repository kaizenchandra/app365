{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "idCard": {
      "type": "string"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "fullName": {
      "type": "string"
    },
    "profilePicture": {
      "type": "string"
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "country": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "municipality": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "sector": {
          "type": "string"
        },
        "line1": {
          "type": "string"
        },
        "line2": {
          "type": "string"
        },
        "zipCode": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "fullAddress": {
          "type": "string"
        }
      },
      "required": [
        "country",
        "city",
        "line1"
      ]
    }
  },
  "required": [
    "idCard",
    "firstName",
    "lastName",
    "address"
  ]
}
