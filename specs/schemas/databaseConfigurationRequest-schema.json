{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host",
    "port",
    "database",
    "service",
    "user",
    "password",
    "driver"
  ],
  "properties": {
    "host": {
      "type": "string"
    },
    "port": {
      "type": "integer"
    },
    "database": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "user": {
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "driverClassName": {
      "type": "string"
    },
    "driver": {
      "type": "string"
    },
    "connectionParameters": {
      "type": "string"
    }
  }
}
