{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subdomain",
    "firstName",
    "lastName"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "candidateId": {
      "type": "string"
    },
    "subdomain": {
      "type": "string"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "phoneCountryCode": {
      "type": "string"
    },
    "candidateFor": {
      "type": "string"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "crm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseUrl": {
              "type": "string"
            },
            "idCardRequireDashes": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
