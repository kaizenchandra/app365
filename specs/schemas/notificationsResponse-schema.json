{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "profilePicture": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "profilePicture"
            ]
          },
          "articles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "coverPicture": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "coverPicture"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "content",
          "createdAt",
          "type",
          "user",
          "articles"
        ]
      }
    },
    "pagination": {
      "type": "object",
      "properties": {
        "totalPages": {
          "type": "integer"
        },
        "totalElements": {
          "type": "integer"
        },
        "page": {
          "type": "integer"
        },
        "pageSize": {
          "type": "integer"
        },
        "numberOfElements": {
          "type": "integer"
        }
      },
      "required": [
        "totalPages",
        "totalElements",
        "page",
        "size",
        "numberOfElements"
      ]
    }
  },
  "required": [
    "data",
    "pagination"
  ]
}
