{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host",
    "port",
    "username",
    "password",
    "protocol"
  ],
  "properties": {
    "host": {
      "type": "string"
    },
    "port": {
      "type": "integer"
    },
    "username": {
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "protocol": {
      "type": "string"
    },
    "authenticationRequired": {
      "type": "boolean"
    },
    "tlsEnable": {
      "type": "boolean"
    },
    "tlsRequired": {
      "type": "boolean"
    }
  }
}
